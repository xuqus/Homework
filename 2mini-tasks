import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

class Graph:
    def __init__(self, func, a, b, label, color):
        x = np.linspace(a, b, 100)
        y = func(x)
        plt.plot(x, y, label=label, color=color, linewidth=2)
        plt.grid(True)
        plt.legend()

Graph(lambda x: 2*x,   0, 10, "y = 2x", "red")
Graph(lambda x: 5*x,   0, 10, "y = 5x", "blue")
Graph(lambda x: x**2,  0, 10, "y = x**2", "pink")

plt.show()





class StudentTable:
    def __init__(self, name, ocenki):
        self.df = pd.DataFrame({"Студент": name, "Оценка": ocenki})

    def show(self):
        print(self.df)
    def average(self):
        print(f"     Средний балл: {self.df['Оценка'].mean()}")

students = StudentTable(["Владимиров Иван", "Зайцев Ярослав", "Михайлов Алексей", "Краснов Олег"],
                        [5, 3, 4, 2])

students.show()
students.average()
